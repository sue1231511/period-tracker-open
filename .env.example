# ── 必填 ──

# Supabase 项目地址：Dashboard → Project Settings → API
SUPABASE_URL=https://你的项目ref.supabase.co

# 服务端密钥（sb_secret_ 开头，或旧版 service_role）。只放在服务器上，千万不要写进前端或提交到仓库。
SUPABASE_SERVICE_KEY=sb_secret_换成你自己的

# 访问密钥：网页登录密码、OAuth 授权页密码、MCP 客户端的 Bearer 密钥都是它。
# 用一个足够长的随机字符串。没配的话服务会拒绝所有请求。
MCP_PROXY_SECRET=换成一个足够长的随机字符串

# 本服务对外的地址，OAuth 要用。例如 https://period.example.com
PUBLIC_BASE_URL=https://period.example.com

# ── 选填 ──

# 网页标题和副标题
APP_TITLE=月相
APP_SUBTITLE=经期与排卵期记录

# 写进 MCP 工具描述里的称呼，例如填「小红」，AI 看到的就是「帮小红记一次经期」。不填用中性说法。
OWNER_NAME=

# 判断「今天」用的时区，默认 Asia/Shanghai
TIMEZONE=Asia/Shanghai

# OAuth 令牌和登录会话在 mcp_oauth_store 表里的 service 名。多个服务共用一张表时用它区分。
OAUTH_SERVICE_NAME=period-mcp

# 端口，大部分部署平台会自动注入
PORT=3000
